{
  "name": "DownAttack",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "npm run services:up && npm run services:wait:database && npm run migration:up && (trap 'npm run services:stop' INT TERM ; nuxt dev)",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "nuxt prepare && eslint . --max-warnings 0",
    "lint:eslint:fix": "npx eslint . --fix",
    "commit": "cz",
    "test": "npm run services:up && concurrently -n nuxt,jest --hide nuxt -k -s command-jest \"nuxt dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env  up",
    "prepare": "husky"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "17.4.2",
    "dotenv-expand": "1000.0.0",
    "jest": "30.5.1",
    "node-pg-migrate": "9.0.0",
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/css": "2.0.0",
    "@eslint/js": "9.39.5",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@nuxt/eslint": "1.17.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "concurrently": "10.0.5",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "secretlint": "13.0.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
